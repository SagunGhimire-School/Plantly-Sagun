# Example for local server process; docs/DEVELOPMENT.md explicitly sets DATABASE_URL in PowerShell.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://plantly:local-development-only@127.0.0.1:5432/plantly
PUBLIC_APP_ORIGIN=http://localhost:3000
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
GEMINI_API_KEY=
AI_ENABLED=false
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

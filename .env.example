# Local-only example. Environment files are NOT authoritative secrets storage.
APP_ENV=local
PUBLIC_APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://plantly:local-development-only@127.0.0.1:5432/plantly
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
PLAN_WORKER_CONCURRENCY=1
PLAN_MAX_ATTEMPTS=3
# OPEN: configure on backend only, AFTER a team decision
GEMINI_API_KEY=
AI_ENABLED=false
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
WEATHER_PROVIDER=
PRICING_PROVIDER=
DEMO_RETENTION_DAYS=
